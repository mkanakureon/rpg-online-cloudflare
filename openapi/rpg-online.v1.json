{
  "openapi": "3.1.0",
  "info": {
    "title": "RPG Online Backend (local PoC)",
    "version": "1.0.0",
    "description": "ローカル専用の PoC。認証はゲストのトークン（POST /v1/accounts/guest が返す Bearer）だけで、ログイン・レート制限・不正対策は未実装。形（欄・型・範囲・状態コードとエラーコードの組）の正はこのファイル、挙動の説明の正は docs/api-contract.md。応答はどれも content-type: application/json; charset=utf-8。状態ごとに返りうるエラーコードは各応答の x-error-codes に書く。スキーマに無いパスとメソッドは 404 NOT_FOUND。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787",
      "description": "npm run dev（APP_ENV=local）"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "生存確認",
        "responses": {
          "200": {
            "description": "動いている。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "想定外の失敗（DB の失敗など）。中身は返さない。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts/guest": {
      "post": {
        "operationId": "issueGuest",
        "summary": "ゲストのアカウントを発行し、そのゲームのプレイヤー ID とトークンを返す。APP_ENV=local のときだけ受け付ける",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "発行した（アカウント 1 つとそのゲームのプレイヤー 1 人を作った）。内部のアカウント ID は返さない。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestIssued"
                }
              }
            }
          },
          "400": {
            "description": "本文が JSON でない（INVALID_JSON）・オブジェクトでない・gameId の形が外れている（INVALID_ARGUMENT）。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "INVALID_ARGUMENT",
              "INVALID_JSON"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "APP_ENV が local でない（本文を読む前に断る）。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "NOT_READY_FOR_PRODUCTION"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "登録の無いゲーム（message は Unknown game）。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "NOT_FOUND"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "想定外の失敗（DB の失敗・署名の鍵が無いなど）。中身は返さない。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/announcements": {
      "get": {
        "operationId": "listAnnouncements",
        "summary": "ゲームのお知らせの一覧（最大 50 件・id の昇順）",
        "parameters": [
          {
            "name": "gameId",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "お知らせの一覧。登録済みのゲームなら、データが無くても 200 と空の items。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnnouncementList"
                }
              }
            }
          },
          "400": {
            "description": "gameId の形が外れている。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "INVALID_ARGUMENT"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "登録の無いゲーム（message は Unknown game）か、お知らせの機能を使わない設定のゲーム（message は Feature not enabled for this game）。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "NOT_FOUND"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "想定外の失敗（DB の失敗など）。中身は返さない。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rankings/{boardId}": {
      "parameters": [
        {
          "name": "boardId",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Id"
          }
        }
      ],
      "get": {
        "operationId": "getRanking",
        "summary": "ランキングの上位（score DESC, updated_at ASC, player_id ASC の順）",
        "parameters": [
          {
            "name": "gameId",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "数字だけの文字列で 1〜50。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ランキングの上位。items は最大 limit 件。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingList"
                }
              }
            }
          },
          "400": {
            "description": "gameId の形が外れている・limit が 1〜50 の外。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "INVALID_ARGUMENT"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "boardId の形が外れている（どのルートにも当たらない）か、登録の無いゲーム（message は Unknown game）か、ランキングの機能を使わない設定のゲーム（message は Feature not enabled for this game）。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "NOT_FOUND"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "想定外の失敗（DB の失敗など）。中身は返さない。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "submitScore",
        "summary": "スコアを送る（同じプレイヤーは最高スコアを残す）。APP_ENV=local のときだけ・トークンの本人の分だけ受け付ける",
        "security": [
          {
            "bearerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "受け付けた。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreAccepted"
                }
              }
            }
          },
          "400": {
            "description": "本文が JSON でない（INVALID_JSON）・オブジェクトでない・欄の形が外れている（INVALID_ARGUMENT）。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "INVALID_ARGUMENT",
              "INVALID_JSON"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authorization が無い・Bearer でない・トークンの形か署名が正しくない（UNAUTHENTICATED）か、トークンの期限が過ぎた（TOKEN_EXPIRED）。本文を読む前に断る。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "UNAUTHENTICATED",
              "TOKEN_EXPIRED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "APP_ENV が local でない（本文を読む前に断る。トークンがあっても無くても）か、本文の gameId・playerId がトークンのゲームとプレイヤーと違う（PERMISSION_DENIED）。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "NOT_READY_FOR_PRODUCTION",
              "PERMISSION_DENIED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "boardId の形が外れている（どのルートにも当たらない）か、登録の無いゲーム（message は Unknown game）か、ランキングの機能を使わない設定のゲーム（message は Feature not enabled for this game）。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "NOT_FOUND"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "想定外の失敗（DB の失敗など）。中身は返さない。",
            "headers": {
              "Cache-Control": {
                "description": "応答はどれも no-store。",
                "required": true,
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "x-error-codes": [
              "INTERNAL_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]{1,64}$",
        "description": "gameId・playerId・boardId で共通の ID の形。"
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "rpg-online-backend"
          }
        }
      },
      "Announcement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "AnnouncementList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameId",
          "items"
        ],
        "properties": {
          "gameId": {
            "$ref": "#/components/schemas/Id"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Announcement"
            }
          }
        }
      },
      "RankingEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "playerId",
          "displayName",
          "score"
        ],
        "properties": {
          "playerId": {
            "$ref": "#/components/schemas/Id"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "1〜40。長さは src/worker.ts に合わせて JavaScript の .length（UTF-16 の単位）で数える（JSON Schema の文字数とは BMP の外の文字で食い違う）。"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        }
      },
      "RankingList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameId",
          "boardId",
          "items"
        ],
        "properties": {
          "gameId": {
            "$ref": "#/components/schemas/Id"
          },
          "boardId": {
            "$ref": "#/components/schemas/Id"
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/RankingEntry"
            }
          }
        }
      },
      "ScoreSubmission": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "gameId",
          "playerId",
          "displayName",
          "score"
        ],
        "description": "知らない欄は無視する（保存しない）。",
        "properties": {
          "gameId": {
            "$ref": "#/components/schemas/Id"
          },
          "playerId": {
            "$ref": "#/components/schemas/Id"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "1〜40。長さは src/worker.ts に合わせて JavaScript の .length（UTF-16 の単位）で数える（JSON Schema の文字数とは BMP の外の文字で食い違う）。"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          }
        }
      },
      "ScoreAccepted": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "gameId",
          "boardId",
          "playerId"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "gameId": {
            "$ref": "#/components/schemas/Id"
          },
          "boardId": {
            "$ref": "#/components/schemas/Id"
          },
          "playerId": {
            "$ref": "#/components/schemas/Id"
          }
        }
      },
      "GuestRequest": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "gameId"
        ],
        "description": "知らない欄は無視する。",
        "properties": {
          "gameId": {
            "$ref": "#/components/schemas/Id"
          }
        }
      },
      "GuestIssued": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameId",
          "playerId",
          "token",
          "expiresAt"
        ],
        "properties": {
          "gameId": {
            "$ref": "#/components/schemas/Id"
          },
          "playerId": {
            "$ref": "#/components/schemas/Id"
          },
          "token": {
            "type": "string",
            "pattern": "^v1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
            "description": "v1.<本文>.<署名>（どちらも base64url）。本文はクライアントが読めるが、形は決めない（Authorization: Bearer に付けて送るだけ）。期限は 30 日。"
          },
          "expiresAt": {
            "type": "string",
            "description": "トークンの期限（ISO 8601・UTC）。過ぎたらゲストを発行し直す。"
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string",
                "description": "人が読むための文。文は決めない（クライアントは code で分ける）。"
              }
            }
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "INVALID_ARGUMENT",
          "NOT_FOUND",
          "NOT_READY_FOR_PRODUCTION",
          "INVALID_JSON",
          "INTERNAL_ERROR",
          "UNAUTHENTICATED",
          "TOKEN_EXPIRED",
          "PERMISSION_DENIED"
        ]
      }
    },
    "securitySchemes": {
      "bearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "POST /v1/accounts/guest が返す token（v1.<本文>.<HMAC-SHA256>・期限 30 日）。形の正は docs/guides/working/account-design.md §4。"
      }
    }
  }
}
