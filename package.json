{
  "name": "rpg-online-cloudflare",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "dev": "wrangler dev --local --var APP_ENV:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cli:smoke": "node scripts/cli-mock.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.3",
    "wrangler": "^4.0.0"
  }
}
